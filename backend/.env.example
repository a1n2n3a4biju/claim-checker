# Copy to backend/.env (never commit it) and fill in your own values.
# v2 uses a NEW database, claimproof_v2, so the old app's data is kept.
# scripts/seed_demo.py creates the database if it doesn't exist yet.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/claimproof_v2

# Signs the sign-in tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=generate-with-python-secrets-token_hex

# Password for every demo account created by scripts/seed_demo.py
DEMO_PASSWORD=choose-a-demo-password
